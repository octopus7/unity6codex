{
  "languageOrder": ["ko", "en", "ja"],
  "entries": [
    {
      "key": "hud.title",
      "translations": {
        "ko": "복셀 마을 언어 데모",
        "en": "Voxel Village Language Demo",
        "ja": "ボクセル村の言語デモ"
      }
    },
    {
      "key": "hud.instructions",
      "translations": {
        "ko": "WASD로 이동\n주민 12명 중 가까운 사람에게 F로 대화\n문 근처에서 F로 열기/닫기\n우측 상단 버튼으로 언어 전환",
        "en": "Move with WASD\nPress F near any of the 12 villagers to talk\nPress F near the door to open or close it\nUse the top-right button to change language",
        "ja": "WASDで移動\n12人の住民の近くでFを押して会話\nドアの近くでFを押して開閉\n右上のボタンで言語を切り替え"
      }
    },
    {
      "key": "hud.controls.show",
      "translations": {
        "ko": "조작법",
        "en": "Controls",
        "ja": "操作方法"
      }
    },
    {
      "key": "hud.controls.hide",
      "translations": {
        "ko": "조작법 닫기",
        "en": "Hide Controls",
        "ja": "操作を閉じる"
      }
    },
    {
      "key": "hud.language.label",
      "translations": {
        "ko": "언어: {0}",
        "en": "Language: {0}",
        "ja": "言語: {0}"
      }
    },
    {
      "key": "language.name.ko",
      "translations": {
        "ko": "한국어",
        "en": "Korean",
        "ja": "韓国語"
      }
    },
    {
      "key": "language.name.en",
      "translations": {
        "ko": "영어",
        "en": "English",
        "ja": "英語"
      }
    },
    {
      "key": "language.name.ja",
      "translations": {
        "ko": "일본어",
        "en": "Japanese",
        "ja": "日本語"
      }
    },
    {
      "key": "interaction.talk",
      "translations": {
        "ko": "F 대화하기",
        "en": "F Talk",
        "ja": "F 会話"
      }
    },
    {
      "key": "interaction.nextLine",
      "translations": {
        "ko": "F 다음 대사",
        "en": "F Next Line",
        "ja": "F 次の台詞"
      }
    },
    {
      "key": "interaction.closeDialogue",
      "translations": {
