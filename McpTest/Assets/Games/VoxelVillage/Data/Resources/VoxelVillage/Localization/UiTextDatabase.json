        "en": "F Talk",
        "ja": "F 話す"
      }
    },
    {
      "key": "interaction.nextLine",
      "translations": {
        "ko": "F 다음 대사",
        "en": "F Next Line",
        "ja": "F 次のセリフ"
      }
    },
    {
