        "ja": "F ドアを開く"
      }
    },
    {
      "key": "interaction.closeDoor",
      "translations": {
        "ko": "F 문 닫기",
        "en": "F Close Door",
        "ja": "F ドアを閉じる"
      }
    },
    {
